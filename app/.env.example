# Copy to .env.local (git-ignored) and adjust.

# Pin the app to a specific Kaspa node, skipping the public resolver whenever
# the node is reachable (unreachable pins fall back to the resolver after a
# ~3s probe). Point it at a local testnet-10 node for instant, deterministic
# RPC connects during development:
#
#   kaspad --testnet --netsuffix=10 --utxoindex --rpclisten-borsh=0.0.0.0:17210
#
# The app speaks wRPC borsh, so the URL must be the borsh listener. Plain ws://
# works from a http://localhost dev page; a deployed https:// app needs wss://
# (TLS-terminated by a reverse proxy in front of the node).
#
# VITE_NODE_URL=ws://127.0.0.1:17210
