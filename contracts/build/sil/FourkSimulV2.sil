        // :: output next: FourkSimulV2
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);

        require(ready_mask >= 0 && ready_mask < 3);
        require(round == 0 && pending_win == 0);
        require(commit1 == zero32() && commit2 == zero32());
        require(reveal1 == 0 && reveal2 == 0);
        require(pk == p1 || pk == p2);
        int next_ready = ready_mask;
        if (pk == p1) {
            require(ready_mask == 0 || ready_mask == 2);
            next_ready = ready_mask + 1;
        } else {
            require(ready_mask == 0 || ready_mask == 1);
            next_ready = ready_mask + 2;
        }
        require(checkSig(s, pk));
        State next_match = State {
            // :: user declared fields
            p1: p1,
            p2: p2,
            board: board,
            round: round,
            commit1: commit1,
            commit2: commit2,
            reveal1: reveal1,
            reveal2: reveal2,
            pending_win: pending_win,
            move_timeout: move_timeout,
            deadline: deadline,
            ready_mask: next_ready,
            pick_deadline: pick_deadline,
            first_committer: first_committer,
            reveal_timeout: reveal_timeout,
        };
        require(tx.outputs[gen__next_output_idx].value == tx.inputs[this.activeInputIndex].value);
        // :: become FourkSimulV2
        validateOutputState(gen__next_output_idx, next_match);
    }

}
