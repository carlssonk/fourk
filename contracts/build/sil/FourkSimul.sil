            require(tx.outputs[1].scriptPubKey == byte[](p2_lock));
            require(tx.outputs[0].value == tx.outputs[1].value);
            require(tx.outputs[0].value >= half_floor);
        } else {
            require(tx.outputs.length == 1);
            pubkey winner_pk = p1;
            if (pending_win == 2) {
