            byte[34] w_lock = new ScriptPubKeyP2PK(winner_pk);
            require(tx.outputs[0].scriptPubKey == byte[](w_lock));
            require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - MAX_FEE);
        }
