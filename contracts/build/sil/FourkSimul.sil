        require(deadline > 0);
        require(tx.time >= deadline);
        require(this.age >= move_timeout);
        require(tx.inputs.length == 1);
        if (pending_win == 0) {
            require(tx.outputs.length == 2);
            int half_floor = (tx.inputs[this.activeInputIndex].value - MAX_FEE) / 2;
            byte[34] p1_lock = new ScriptPubKeyP2PK(p1);
